+/* Token2/Feitian vendor: send a raw ISO-7816 APDU over CTAPHID_MSG (for HID-only
+ * keys that answer vendor APDUs like 80 E3 EE 80 00 on the MSG channel). Copies up
+ * to *rx_len bytes of the reply (including SW) into rx and updates *rx_len. */
+int
+fido_dev_token2_apdu(fido_dev_t *dev, const unsigned char *apdu, size_t apdu_len,
+    unsigned char *rx, size_t *rx_len)
+{
+	unsigned char *reply;
+	int ms = dev->timeout_ms;
+	int n;
+
+	if (dev == NULL || apdu == NULL || rx == NULL || rx_len == NULL)
+		return (FIDO_ERR_INVALID_ARGUMENT);
+	if ((reply = malloc(FIDO_MAXMSG)) == NULL)
+		return (FIDO_ERR_INTERNAL);
+	if (fido_tx(dev, CTAP_CMD_MSG, apdu, apdu_len, &ms) < 0) {
+		free(reply);
+		return (FIDO_ERR_TX);
+	}
+	if ((n = fido_rx(dev, CTAP_CMD_MSG, reply, FIDO_MAXMSG, &ms)) < 0) {
+		free(reply);
+		return (FIDO_ERR_RX);
+	}
+	if ((size_t)n > *rx_len)
+		n = (int)*rx_len;
+	memcpy(rx, reply, (size_t)n);
+	*rx_len = (size_t)n;
+	free(reply);
+	return (FIDO_OK);
+}
