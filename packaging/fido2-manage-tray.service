[Unit]
Description=fido2-manage system tray (auto-open on security-key insertion)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# %h expands to the user's home directory. Adjust if installed elsewhere.
ExecStart=/usr/bin/python3 %h/fido2-manage/fido2_tray.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
