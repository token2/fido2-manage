+/* Token2: emit the same device/authenticator attributes as the plain -I output
+ * but as a single JSON object. ci is NULL for non-FIDO2 (U2F) devices. */
+static void
+token_info_json(fido_dev_t *dev, const fido_cbor_info_t *ci)
+{
+	int first = 1;
+	int ival;
+	size_t i, n;
+
+#define J_SEP() do { if (!first) putchar(','); first = 0; } while (0)
+
+	putchar('{');
+
+	J_SEP(); printf("\"proto\":%d", fido_dev_protocol(dev));
+	J_SEP(); printf("\"major\":%d", fido_dev_major(dev));
+	J_SEP(); printf("\"minor\":%d", fido_dev_minor(dev));
+	J_SEP(); printf("\"build\":%d", fido_dev_build(dev));
+	J_SEP(); printf("\"caps\":%d", fido_dev_flags(dev));
+	J_SEP(); printf("\"fido2\":%s", ci != NULL ? "true" : "false");
+
+	if (ci != NULL) {
+		char * const *sa;
+		const bool *bv;
+		const uint64_t *cv;
+		const uint8_t *by;
+
+		J_SEP(); printf("\"versions\":[");
+		sa = fido_cbor_info_versions_ptr(ci);
+		n = fido_cbor_info_versions_len(ci);
+		for (i = 0; i < n; i++) { if (i) putchar(','); json_string(sa[i]); }
+		putchar(']');
+
+		J_SEP(); printf("\"extensions\":[");
+		sa = fido_cbor_info_extensions_ptr(ci);
+		n = fido_cbor_info_extensions_len(ci);
+		for (i = 0; i < n; i++) { if (i) putchar(','); json_string(sa[i]); }
+		putchar(']');
+
+		J_SEP(); printf("\"transports\":[");
+		sa = fido_cbor_info_transports_ptr(ci);
+		n = fido_cbor_info_transports_len(ci);
+		for (i = 0; i < n; i++) { if (i) putchar(','); json_string(sa[i]); }
+		putchar(']');
+
+		J_SEP(); printf("\"algorithms\":[");
+		n = fido_cbor_info_algorithm_count(ci);
+		for (i = 0; i < n; i++) {
+			const char *cose = "unknown";
+			switch (fido_cbor_info_algorithm_cose(ci, i)) {
+			case COSE_ES256: cose = "es256"; break;
+			case COSE_ES384: cose = "es384"; break;
+			case COSE_RS256: cose = "rs256"; break;
+			case COSE_EDDSA: cose = "eddsa"; break;
+			}
+			if (i) putchar(',');
+			printf("{\"cose\":"); json_string(cose);
+			printf(",\"type\":"); json_string(fido_cbor_info_algorithm_type(ci, i));
+			putchar('}');
+		}
+		putchar(']');
+
+		J_SEP(); printf("\"aaguid\":\"");
+		by = fido_cbor_info_aaguid_ptr(ci);
+		n = fido_cbor_info_aaguid_len(ci);
+		for (i = 0; i < n; i++) printf("%02x", by[i]);
+		putchar('"');
+
+		J_SEP(); printf("\"options\":{");
+		sa = fido_cbor_info_options_name_ptr(ci);
+		bv = fido_cbor_info_options_value_ptr(ci);
+		n = fido_cbor_info_options_len(ci);
+		for (i = 0; i < n; i++) {
+			if (i) putchar(',');
+			json_string(sa[i]);
+			printf(":%s", bv[i] ? "true" : "false");
+		}
+		putchar('}');
+
+		J_SEP(); printf("\"certifications\":{");
+		sa = fido_cbor_info_certs_name_ptr(ci);
+		cv = fido_cbor_info_certs_value_ptr(ci);
+		n = fido_cbor_info_certs_len(ci);
+		for (i = 0; i < n; i++) {
+			if (i) putchar(',');
+			json_string(sa[i]);
+			printf(":%llu", (unsigned long long)cv[i]);
+		}
+		putchar('}');
+
+		J_SEP(); printf("\"fwversion\":%llu", (unsigned long long)fido_cbor_info_fwversion(ci));
+		J_SEP(); printf("\"maxmsgsiz\":%llu", (unsigned long long)fido_cbor_info_maxmsgsiz(ci));
+		J_SEP(); printf("\"maxcredcntlst\":%llu", (unsigned long long)fido_cbor_info_maxcredcntlst(ci));
+		J_SEP(); printf("\"maxcredidlen\":%llu", (unsigned long long)fido_cbor_info_maxcredidlen(ci));
+		J_SEP(); printf("\"maxcredbloblen\":%llu", (unsigned long long)fido_cbor_info_maxcredbloblen(ci));
+		J_SEP(); printf("\"maxlargeblob\":%llu", (unsigned long long)fido_cbor_info_maxlargeblob(ci));
+		J_SEP(); printf("\"maxrpid_minpinlen\":%llu", (unsigned long long)fido_cbor_info_maxrpid_minpinlen(ci));
+		J_SEP(); printf("\"rk_remaining\":%lld", (long long)fido_cbor_info_rk_remaining(ci));
+		J_SEP(); printf("\"minpinlen\":%llu", (unsigned long long)fido_cbor_info_minpinlen(ci));
+
+		J_SEP(); printf("\"pin_protocols\":[");
+		by = fido_cbor_info_protocols_ptr(ci);
+		n = fido_cbor_info_protocols_len(ci);
+		for (i = 0; i < n; i++) { if (i) putchar(','); printf("%u", (unsigned)by[i]); }
+		putchar(']');
+
+		J_SEP(); printf("\"new_pin_required\":%s", fido_cbor_info_new_pin_required(ci) ? "true" : "false");
+		J_SEP(); printf("\"uv_attempts\":%llu", (unsigned long long)fido_cbor_info_uv_attempts(ci));
+		J_SEP(); printf("\"uv_modality\":%llu", (unsigned long long)fido_cbor_info_uv_modality(ci));
+	}
+
+	J_SEP();
+	if (fido_dev_get_retry_count(dev, &ival) == FIDO_OK)
+		printf("\"pin_retries\":%d", ival);
+	else
+		printf("\"pin_retries\":null");
+
+	J_SEP();
+	if (fido_dev_get_uv_retry_count(dev, &ival) == FIDO_OK)
+		printf("\"uv_retries\":%d", ival);
+	else
+		printf("\"uv_retries\":null");
+
+	printf("}\n");
+
+#undef J_SEP
+}
