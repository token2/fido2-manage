+/*
+ * Token2: minimal JSON output support for the command-line tools.
+ *
+ * getopt(3) cannot parse "-json"/"--json" (they are not single-character
+ * options), so json_strip_argv() is called from each tool's main() BEFORE
+ * getopt: it removes those tokens from argv, shrinks argc, and raises the
+ * global fido_json flag. The output code then branches on fido_json.
+ */
+int fido_json = 0;
+
+void
+json_strip_argv(int *argc, char **argv)
+{
+	int w = 1;
+
+	for (int i = 1; i < *argc; i++) {
+		if (strcmp(argv[i], "-json") == 0 ||
+		    strcmp(argv[i], "--json") == 0) {
+			fido_json = 1;
+			continue;
+		}
+		argv[w++] = argv[i];
+	}
+	argv[w] = NULL;
+	*argc = w;
+}
+
+/* Print s as a quoted, escaped JSON string (prints "null" for NULL). */
+void
+json_string(const char *s)
+{
+	const unsigned char *p;
+
+	if (s == NULL) {
+		fputs("null", stdout);
+		return;
+	}
+	putchar('"');
+	for (p = (const unsigned char *)s; *p != '\0'; p++) {
+		switch (*p) {
+		case '"':
+			fputs("\\\"", stdout);
+			break;
+		case '\\':
+			fputs("\\\\", stdout);
+			break;
+		case '\b':
+			fputs("\\b", stdout);
+			break;
+		case '\f':
+			fputs("\\f", stdout);
+			break;
+		case '\n':
+			fputs("\\n", stdout);
+			break;
+		case '\r':
+			fputs("\\r", stdout);
+			break;
+		case '\t':
+			fputs("\\t", stdout);
+			break;
+		default:
+			if (*p < 0x20)
+				printf("\\u%04x", (unsigned)*p);
+			else
+				putchar(*p);
+			break;
+		}
+	}
+	putchar('"');
+}
