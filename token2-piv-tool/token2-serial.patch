+/* Token2 OTP applet: full serial number over CCID */
+static const uint8_t t2_otp_aid[] = {0xf0, 0x00, 0x00, 0x01, 0x4f, 0x74, 0x70, 0x01};
+
+static ykpiv_rc _ykpiv_get_serial_str(ykpiv_state *state) {
+  ykpiv_rc res = YKPIV_OK;
+  uint8_t select_templ[] = {0x00, YKPIV_INS_SELECT_APPLICATION, 0x04, 0x00};
+  uint8_t temp[256] = {0};
+  unsigned long recv_len = sizeof(temp);
+  int sw = 0;
+  /* 80 33 00 00 | extended Lc 00 00 12 | D1 10 + 16 zero bytes */
+  uint8_t get_info[7 + 18] = {0x80, 0x33, 0x00, 0x00, 0x00, 0x00, 0x12, 0xd1, 0x10};
+  uint8_t resp[261] = {0};
+  pcsc_word resp_len = sizeof(resp);
+
+  if (!state) return YKPIV_ARGUMENT_ERROR;
+  if (state->serial_str[0]) return YKPIV_OK;
+
+  if ((res = _ykpiv_transfer_data(state, select_templ, t2_otp_aid, sizeof(t2_otp_aid), temp, &recv_len, &sw)) != YKPIV_OK ||
+      ykpiv_translate_sw_ex(__FUNCTION__, sw) != YKPIV_OK) {
+    DBG("OTP applet not available, no full serial number");
+    res = YKPIV_NOT_SUPPORTED;
+    goto Reselect;
+  }
+
+  if ((res = _ykpiv_transmit(state, get_info, sizeof(get_info), resp, &resp_len, &sw)) != YKPIV_OK) {
+    goto Reselect;
+  }
+  if ((sw >> 8) == 0x61) {
+    /* response pending: GET RESPONSE */
+    uint8_t get_resp[] = {0x00, 0xc0, 0x00, 0x00, (uint8_t)(sw & 0xff)};
+    resp_len = sizeof(resp);
+    if ((res = _ykpiv_transmit(state, get_resp, sizeof(get_resp), resp, &resp_len, &sw)) != YKPIV_OK) {
+      goto Reselect;
+    }
+  }
+  if ((res = ykpiv_translate_sw_ex(__FUNCTION__, sw)) != YKPIV_OK) {
+    DBG("OTP applet GET_INFO failed");
+    goto Reselect;
+  }
+  /* resp: D1 | len | ASCII serial (status word already split off by _ykpiv_transmit) */
+  if (resp_len < 3 || resp[0] != 0xd1 || resp[1] == 0 || (unsigned)resp[1] + 2 > resp_len ||
+      resp[1] >= sizeof(state->serial_str)) {
+    DBG("OTP applet GET_INFO: unexpected response");
+    res = YKPIV_PARSE_ERROR;
+    goto Reselect;
+  }
+  memcpy(state->serial_str, resp + 2, resp[1]);
+  state->serial_str[resp[1]] = 0;
+
+Reselect:
+  recv_len = sizeof(temp);
+  {
+    ykpiv_rc r2 = _ykpiv_transfer_data(state, select_templ, piv_aid, sizeof(piv_aid), temp, &recv_len, &sw);
+    if (r2 != YKPIV_OK || ykpiv_translate_sw_ex(__FUNCTION__, sw) != YKPIV_OK) {
+      DBG("Failed re-selecting piv application");
+      if (res == YKPIV_OK) res = r2 != YKPIV_OK ? r2 : YKPIV_GENERIC_ERROR;
+    }
+  }
+  return res;
+}
+
+ykpiv_rc ykpiv_get_serial_str(ykpiv_state *state, char *buf, size_t len) {
+  ykpiv_rc res;
+  if (!state || !buf || len == 0) return YKPIV_ARGUMENT_ERROR;
+  uint8_t scp11 = state->scp11_state.security_level;
+  if ((res = _ykpiv_begin_transaction(state)) != YKPIV_OK) return res;
+  if ((res = _ykpiv_ensure_application_selected(state, scp11)) != YKPIV_OK) goto Cleanup;
+  res = _ykpiv_get_serial_str(state);
+  if (res == YKPIV_OK) {
+    if (strlen(state->serial_str) >= len) { res = YKPIV_SIZE_ERROR; goto Cleanup; }
+    strcpy(buf, state->serial_str);
+  }
+Cleanup:
+  _ykpiv_end_transaction(state);
+  return res;
+}
